{
  "expo": {
    "name": "ForkIt",
    "slug": "forkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forkit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#232121"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seandm.forkit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:forkit-server-production.up.railway.app"
      ]
    },
    "android": {
      "package": "com.seandm.forkit",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "forkit-server-production.up.railway.app",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://forkit-server-production.up.railway.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ForkIt uses your location to find restaurants near you so the group can swipe on nearby dishes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://forkit-server-production.up.railway.app"
      },
      "eas": {
        "projectId": "39ca2d5c-53e8-4c29-b917-9a8f01488a59"
      }
    },
    "owner": "seanzmc9613"
  }
}
