{
  "name": "forkit",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist --out-extension:.js=.mjs",
    "server:prod": "NODE_ENV=production node server_dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "start": "EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN:-localhost:5000} npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "expo": "^58.0.2",
    "expo-asset": "~58.0.10",
    "expo-blur": "~58.0.3",
    "expo-constants": "~58.0.9",
    "expo-crypto": "~58.0.4",
    "expo-dev-client": "~58.0.10",
    "expo-font": "~58.0.5",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.4",
    "expo-image": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.10",
    "expo-location": "~58.0.10",
    "expo-notifications": "~58.0.11",
    "expo-router": "~58.0.12",
    "expo-splash-screen": "~58.0.4",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "expo-web-browser": "~58.0.4",
    "express": "^5.0.1",
    "http-proxy-middleware": "^3.0.5",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.13.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~58.0.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
